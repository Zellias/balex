{
  "name": "balex",
  "version": "1.2.0",
  "description": "High-performance Node.js & Go-compatible userbot, client library, and Bot API for Bale Messenger with 53 Protobuf services and 636 RPC methods",
  "main": "index.js",
  "types": "index.d.ts",
  "bin": {
    "balex": "./bin/cli.js",
    "bale-userbot": "./bin/cli.js"
  },
  "scripts": {
    "start": "node index.js",
    "bridge": "node src/bridge.js",
    "typecheck": "node tests/test_types.js",
    "test": "node tests/run_all.js",
    "extract": "node scripts/extract-methods.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zellias/balex.git"
  },
  "homepage": "https://zellias.github.io/balex/",
  "keywords": [
    "bale",
    "bale-messenger",
    "bale-userbot",
    "balex",
    "bale-bot",
    "userbot",
    "protobuf",
    "mkproto",
    "go",
    "golang",
    "telegram-alternative"
  ],
  "author": "Hossein Rangani (Zellias)",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "optionalDependencies": {
    "ws": "^8.18.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "bin",
    "docs",
    "README.md",
    "LICENSE"
  ]
}
